{
  "name": "nodejs-tutorial-server",
  "version": "1.0.0",
  "description": "Node.js tutorial server with Express.js framework providing HTTP endpoints for 'Hello world' and 'Good evening' responses",
  "main": "server.js",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
