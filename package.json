  },
  "devDependencies": {
    "cross-env": "^7.0.0",
    "jest": "^29.0.0",
    "node-mocks-http": "^1.13.0",
    "supertest": "^6.3.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
