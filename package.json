{
  "name": "testinium-qa-nodejs",
  "version": "1.0.0",
  "description": "Node.js testing infrastructure for Testinium QA BDD framework",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "jest --watchAll=false --ci --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "coverage:report": "jest --coverage --coverageReporters=html"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "@types/jest": "29.5.0",
    "@types/supertest": "6.0.0",
    "@types/node": "20.0.0",
    "sinon": "17.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 95,
        "lines": 90,
        "statements": 90
      }
    },
    "testTimeout": 5000,
    "maxWorkers": 2
  },
  "keywords": [
    "testing",
    "bdd",
    "nodejs",
    "jest",
    "supertest",
    "server-testing"
  ],
  "author": "Testinium QA Team",
  "license": "MIT"
}