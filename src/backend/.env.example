# ============================================================================
# NODE.JS TUTORIAL PROJECT - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# 
# This file serves as a comprehensive template for all environment variables
# required by the Node.js tutorial project. It demonstrates modern environment
# variable management practices for Node.js v22.x LTS with Express.js v5.1.0.
#
# IMPORTANT SECURITY NOTES:
# - Never commit actual .env files containing sensitive data to version control
# - Copy this file to .env and customize values for your environment
# - Use different .env files for different environments (development, production, staging, test)
# - Follow the principle of least privilege when setting security configurations
#
# TUTORIAL PHASES SUPPORTED:
# Phase 1: Basic server configuration (PORT, HOST, NODE_ENV)
# Phase 2: Express.js integration (security, logging, middleware)
# Phase 3: Flask compatibility (cross-platform variables)
# Phase 4: Testing configuration (framework, coverage, timeouts)
# Phase 5: PM2 production deployment (cluster, monitoring)
# Phase 6: Security implementation (HTTPS, headers, CORS)
# Phase 7: Production monitoring (health checks, metrics)
#
# ============================================================================

# ============================================================================
# CORE APPLICATION CONFIGURATION
# ============================================================================
# Essential settings for Node.js v22.x LTS and Express.js v5.1.0 operation

# Deployment environment identifier - critical for feature flags and security policies
# Values: development | production | staging | test
# Default: development
NODE_ENV=development

# HTTP server port number - must be available and not conflict with other services
# Range: 1024-65535 (avoid system ports 1-1023)
# Default: 3000 (standard Node.js development port)
PORT=3000

# Server host binding address - controls network interface binding
# Values: localhost | 0.0.0.0 | 127.0.0.1
# localhost/127.0.0.1: local development only
# 0.0.0.0: accepts connections from any network interface (production)
# Default: localhost
HOST=localhost

# Application name for logging, process identification, and PM2 management
# Used by PM2 for process naming and log file organization
# Default: nodejs-tutorial-app
APP_NAME=nodejs-tutorial-app

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Comprehensive logging setup supporting development and production environments

# Application logging level - controls verbosity of log output
# Values: error | warn | info | debug | verbose
# Production: warn or error, Development: debug or info
# Default: info
LOG_LEVEL=info

# Log output format - structured vs human-readable
# Values: json | simple | combined
# json: structured logging for production and log aggregation
# simple: human-readable for development
# combined: Apache common log format
# Default: json
LOG_FORMAT=json

# Path for combined log file output - all log levels except errors
# Supports relative and absolute paths
# Default: ./logs/combined.log
LOG_FILE_PATH=./logs/combined.log

# Path for error-specific log file - error level logs only
# Critical for production error tracking and debugging
# Default: ./logs/error.log
LOG_ERROR_FILE=./logs/error.log

# Maximum log file size before rotation - prevents disk space issues
# Format: number + unit (k, m, g) - e.g., 20m = 20 megabytes
# Default: 20m
LOG_MAX_SIZE=20m

# Maximum number of log files to retain during rotation
# Balances storage usage with historical log availability
# Default: 14 (two weeks of daily logs)
LOG_MAX_FILES=14

# ============================================================================
# PM2 PRODUCTION CONFIGURATION
# ============================================================================
# PM2 v6.0.8 process management for production deployment and clustering

# PM2 application name for process management and monitoring
# Must match ecosystem.config.js if using ecosystem file
# Default: nodejs-tutorial-app
PM2_APP_NAME=nodejs-tutorial-app

# Number of PM2 instances - leverages multi-core systems
# Values: max | 1 | 2 | 4 | 8 | number
# max: automatically detects CPU cores and creates that many instances
# number: specific instance count for fine-tuned control
# Default: max (optimal for production performance)
PM2_INSTANCES=max

# PM2 execution mode - controls clustering and load balancing
# Values: cluster | fork
# cluster: enables built-in load balancer and multi-process scaling
# fork: single process mode for development or specific use cases
# Default: cluster (recommended for production)
PM2_EXEC_MODE=cluster

# Memory limit for automatic PM2 restart - prevents memory leaks
# Format: number + unit (M, G) - e.g., 1G = 1 gigabyte
# Automatically restarts process when memory usage exceeds limit
# Default: 1G
PM2_MAX_MEMORY_RESTART=1G

# Enable automatic restart on application crashes
# Values: true | false
# Critical for production availability and fault tolerance
# Default: true
PM2_AUTORESTART=true

# Enable file watching for automatic restart on code changes
# Values: true | false
# Useful for development, should be false in production
# Default: false (production-safe setting)
PM2_WATCH=false

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Comprehensive security settings compatible with Helmet.js and Express.js v5.1.0

# Overall security enforcement level - affects all security middleware
# Values: relaxed | standard | strict
# relaxed: development-friendly with basic security
# standard: balanced security for staging environments
# strict: maximum security for production deployment
# Default: standard
SECURITY_LEVEL=standard

# Enforce HTTPS redirect in production environments
# Values: true | false
# Should be true in production with valid SSL certificates
# Default: false (allows HTTP for development)
HTTPS_ENFORCED=false

# Path to SSL certificate file for HTTPS implementation
# Required when HTTPS_ENFORCED=true
# Default: ./certificates/server.crt
SSL_CERT_PATH=./certificates/server.crt

# Path to SSL private key file for HTTPS implementation
# Must be kept secure and never committed to version control
# Default: ./certificates/server.key
SSL_KEY_PATH=./certificates/server.key

# Enable Content Security Policy headers via Helmet.js
# Values: true | false
# Mitigates XSS and injection attacks
# Default: true (recommended for all environments)
HELMET_CSP_ENABLED=true

# Enable HTTP Strict Transport Security headers
# Values: true | false
# Forces HTTPS connections and prevents protocol downgrade attacks
# Default: true (essential for production HTTPS)
HELMET_HSTS_ENABLED=true

# Enable X-Content-Type-Options nosniff header
# Values: true | false
# Prevents MIME type confusion attacks
# Default: true (standard security practice)
HELMET_NOSNIFF_ENABLED=true

# ============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# ============================================================================
# CORS policy management for API access control

# Enable Cross-Origin Resource Sharing middleware
# Values: true | false
# Required for API access from different domains
# Default: true
CORS_ENABLED=true

# Allowed CORS origins - comma-separated list of permitted domains
# Values: * | specific domains
# *: allows all origins (development only)
# specific domains: production security best practice
# Example: http://localhost:3000,https://yourdomain.com
# Default: *
CORS_ORIGIN=*

# Allowed HTTP methods for CORS requests
# Comma-separated list of permitted HTTP methods
# Default: GET,HEAD,PUT,PATCH,POST,DELETE
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Allow credentials in CORS requests (cookies, authentication headers)
# Values: true | false
# Should be false unless specifically required for authentication
# Default: false
CORS_CREDENTIALS=false

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Request rate limiting to prevent abuse and ensure service availability

# Enable rate limiting middleware protection
# Values: true | false
# Essential for production API protection
# Default: true
RATE_LIMIT_ENABLED=true

# Rate limit time window in milliseconds
# 900000ms = 15 minutes
# Define the time period for rate limit calculations
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per time window
# Balances legitimate usage with abuse prevention
# Default: 100 requests per 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Custom message returned when rate limit is exceeded
# Should be informative but not reveal system details
# Default: Too many requests from this IP, please try again later
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Testing framework configuration supporting Jest and Mocha (Node.js 18+)

# Testing framework selection - supports dual framework approach
# Values: jest | mocha
# jest: all-in-one testing solution with built-in coverage
# mocha: flexible framework requiring additional libraries
# Default: jest
TEST_FRAMEWORK=jest

# Test execution timeout in milliseconds
# Prevents hanging tests and ensures timely feedback
# Default: 30000 (30 seconds)
TEST_TIMEOUT=30000

# Minimum code coverage percentage threshold
# Quality gate for test coverage enforcement
# Default: 90% (high quality standard)
TEST_COVERAGE_THRESHOLD=90

# Port for test server instances - must not conflict with main application
# Used for integration and end-to-end testing
# Default: 3001
TEST_PORT=3001

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database settings for future tutorial phases (currently stateless)

# Enable database integration - tutorial is currently stateless
# Values: true | false
# Set to false for current stateless implementation
# Default: false
DATABASE_ENABLED=false

# Database connection URL for future implementation phases
# Format depends on database type (PostgreSQL, MongoDB, SQLite)
# Example: postgresql://user:password@localhost:5432/tutorial_db
# Default: empty (no database connection)
DATABASE_URL=

# Database type specification for future development phases
# Values: none | postgresql | mongodb | sqlite
# none: current stateless implementation
# Default: none
DATABASE_TYPE=none

# ============================================================================
# MONITORING AND HEALTH CHECK CONFIGURATION
# ============================================================================
# Application monitoring and health check endpoints

# Enable application monitoring and metrics collection
# Values: true | false
# Provides insights into application performance and health
# Default: true
MONITORING_ENABLED=true

# Health check endpoint path for load balancers and monitoring tools
# Standard endpoint for application health verification
# Default: /health
HEALTH_CHECK_ENDPOINT=/health

# Enable performance metrics collection and reporting
# Values: true | false
# Useful for production performance optimization
# Default: true
METRICS_ENABLED=true

# Enable comprehensive performance monitoring
# Values: true | false
# Includes response time, memory usage, and CPU metrics
# Default: true
PERFORMANCE_MONITORING=true

# ============================================================================
# FLASK CROSS-PLATFORM COMPATIBILITY
# ============================================================================
# Environment variables for maintaining Node.js/Flask feature parity

# Flask environment setting for cross-platform compatibility
# Values: development | production
# Should mirror NODE_ENV behavior
# Default: development
FLASK_ENV=development

# Flask debug mode - should align with NODE_ENV setting
# Values: true | false
# Should be false in production environments
# Default: false
FLASK_DEBUG=false

# Flask secret key for session management and CSRF protection
# Required for Flask session handling and security features
# Must be a strong, randomly generated key in production
# Default: empty (must be set for Flask applications)
FLASK_SECRET_KEY=your-secret-key-here

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Development-specific settings for enhanced debugging and productivity

# Enable debug mode for enhanced development experience
# Values: true | false
# Provides detailed error messages and debugging information
# Should be false in production
# Default: false
DEBUG_MODE=false

# Enable hot reload for development file watching
# Values: true | false
# Automatically restarts server on file changes
# Should be false in production for stability
# Default: false
HOT_RELOAD=false

# Enable verbose logging for detailed debugging information
# Values: true | false
# Provides comprehensive logging for troubleshooting
# Should be false in production to reduce log volume
# Default: false
VERBOSE_LOGGING=false

# ============================================================================
# CI/CD AND BUILD CONFIGURATION
# ============================================================================
# Continuous integration and deployment settings

# Indicates execution in CI/CD environment
# Values: true | false
# Affects testing behavior and resource allocation
# Default: false
CI_MODE=false

# Application build version for deployment tracking
# Should be updated with each release
# Default: 1.0.0
BUILD_VERSION=1.0.0

# Git commit hash for deployment tracking and rollback capability
# Automatically populated by CI/CD systems
# Example: abc123def456
# Default: empty
GIT_COMMIT=

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================
# 
# PRODUCTION ENVIRONMENT RECOMMENDATIONS:
# NODE_ENV=production
# LOG_LEVEL=warn
# HTTPS_ENFORCED=true
# PM2_EXEC_MODE=cluster
# PM2_INSTANCES=max
# SECURITY_LEVEL=strict
# CORS_ORIGIN=https://yourdomain.com
# 
# DEVELOPMENT ENVIRONMENT RECOMMENDATIONS:
# NODE_ENV=development
# LOG_LEVEL=debug
# HTTPS_ENFORCED=false
# PM2_EXEC_MODE=fork
# PM2_INSTANCES=1
# SECURITY_LEVEL=relaxed
# CORS_ORIGIN=*
#
# TESTING ENVIRONMENT RECOMMENDATIONS:
# NODE_ENV=test
# PORT=3001
# LOG_LEVEL=error
# MONITORING_ENABLED=false
# RATE_LIMIT_ENABLED=false
#
# ============================================================================
# SECURITY BEST PRACTICES REMINDER
# ============================================================================
#
# 1. Never commit actual .env files with real values
# 2. Use strong, unique values for all secret keys and passwords
# 3. Regularly rotate secrets and API keys
# 4. Use environment-specific configurations
# 5. Validate and sanitize all environment variables in application code
# 6. Monitor and audit environment variable usage
# 7. Use proper file permissions (600) for .env files
# 8. Consider using secret management services for production
#
# ============================================================================