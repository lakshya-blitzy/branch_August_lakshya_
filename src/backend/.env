# =============================================================================
# NODE.JS TUTORIAL PROJECT - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# This file contains actual runtime environment variable values for the 
# Node.js tutorial project development environment. It supports progressive
# enhancement from basic HTTP server through production-ready deployment.
#
# ⚠️  SECURITY WARNING: This file contains actual configuration values and
#     should NOT be committed to version control. Use .env.example as template.
#
# Tutorial Phases Supported:
# - Phase 1: Basic HTTP Server (NODE_ENV, PORT, HOST)
# - Phase 2: Express.js Framework (security and CORS variables)
# - Phase 3: Flask Cross-Platform Compatibility (FLASK_* variables)
# - Phase 4: Testing Framework Integration (TEST_* variables)
# - Phase 5: PM2 Production Deployment (PM2_* variables)
# - Phase 6: Security Hardening (SSL_*, RATE_LIMIT_* variables)
# - Phase 7: Monitoring and Logging (LOG_*, MONITORING_* variables)
# =============================================================================

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================
# Primary application settings for Node.js v22.x LTS with Express.js v5.1.0
# Used by: config/environment.js, server.js

# Current deployment environment identifier
# Validation: Must be one of: development, production, staging, test
NODE_ENV=development

# HTTP server port number for Express.js application
# Validation: Must be between 1024-65535, default 3000
# Used by: server.js for port binding and config/environment.js
PORT=3000

# Server host binding address for development
# Validation: Valid hostname or IP address
# Used by: server.js for server binding configuration
HOST=localhost

# Application name for logging and PM2 process identification
# Validation: String without spaces or special characters
# Used by: utils/logger.js and PM2 configuration
APP_NAME=nodejs-tutorial-app

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Application logging settings for development and production environments
# Used by: utils/logger.js, config/environment.js

# Application logging verbosity level for debugging
# Validation: Must be one of: error, warn, info, debug, verbose
# Used by: utils/logger.js for log filtering
LOG_LEVEL=info

# Log output format for structured logging
# Validation: Must be one of: json, simple, combined
# Used by: utils/logger.js for log formatting configuration
LOG_FORMAT=json

# File path for combined application logs
# Validation: Valid file path with write permissions
# Used by: utils/logger.js and PM2 log configuration
LOG_FILE_PATH=./logs/combined.log

# File path for error-only logs
# Validation: Valid file path with write permissions
# Used by: utils/logger.js for error log separation
LOG_ERROR_FILE=./logs/error.log

# =============================================================================
# PM2 PRODUCTION CONFIGURATION
# =============================================================================
# PM2 process manager settings for production deployment and cluster mode
# PM2 v6.0.8 provides enterprise-grade process management with built-in load balancer
# Used by: ecosystem.config.js, PM2 deployment scripts

# PM2 application identifier for process management
# Validation: String without spaces, used as process name
# Used by: ecosystem.config.js and PM2 deployment scripts
PM2_APP_NAME=nodejs-tutorial-app

# Number of PM2 worker instances (max = CPU cores)
# Validation: Either 'max' or positive integer
# Used by: ecosystem.config.js for cluster mode configuration
PM2_INSTANCES=max

# PM2 execution mode for process management
# Validation: Must be either 'cluster' or 'fork'
# Used by: ecosystem.config.js for cluster vs fork mode
PM2_EXEC_MODE=cluster

# Memory limit for automatic PM2 process restart
# Validation: Memory size with unit (e.g., 1G, 512M)
# Used by: ecosystem.config.js for memory management
PM2_MAX_MEMORY_RESTART=1G

# Enable automatic restart on process crashes
# Validation: Boolean true/false
# Used by: ecosystem.config.js for restart policy
PM2_AUTORESTART=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Security settings including Helmet.js middleware and HTTPS configuration
# Express.js v5.1.0 includes enhanced security features and ReDoS protection
# Used by: config/security.js, middleware/security.js

# Overall security enforcement level
# Validation: Must be one of: relaxed, standard, strict
# Used by: config/security.js for security policy selection
SECURITY_LEVEL=standard

# Enforce HTTPS redirect in production (disabled for development)
# Validation: Boolean true/false
# Used by: config/security.js and middleware/security.js
HTTPS_ENFORCED=false

# Path to SSL certificate file for HTTPS
# ⚠️  SECURITY SENSITIVE: Should be readable only by application user
# Validation: Valid file path to certificate
# Used by: server.js for HTTPS server creation
SSL_CERT_PATH=./certificates/server.crt

# Path to SSL private key file for HTTPS
# ⚠️  SECURITY SENSITIVE: Should be readable only by application user
# Validation: Valid file path to private key
# Used by: server.js for HTTPS server creation
SSL_KEY_PATH=./certificates/server.key

# Enable Content Security Policy headers via Helmet.js
# Validation: Boolean true/false
# Used by: middleware/helmet-config.js for CSP configuration
HELMET_CSP_ENABLED=true

# Enable HTTP Strict Transport Security headers
# Validation: Boolean true/false
# Used by: middleware/helmet-config.js for HSTS configuration
HELMET_HSTS_ENABLED=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Cross-Origin Resource Sharing settings for API access control
# Used by: middleware/cors.js for CORS policy enforcement

# Enable Cross-Origin Resource Sharing middleware
# Validation: Boolean true/false
# Used by: middleware/cors.js for CORS policy enforcement
CORS_ENABLED=true

# Allowed CORS origins (comma-separated for multiple)
# Validation: Valid URL(s) or '*' for development
# Used by: middleware/cors.js for origin validation
CORS_ORIGIN=*

# Allowed HTTP methods for CORS requests
# Validation: Comma-separated HTTP methods
# Used by: middleware/cors.js for method validation
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Allow credentials in CORS requests
# Validation: Boolean true/false
# Used by: middleware/cors.js for credential handling
CORS_CREDENTIALS=false

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Request rate limiting settings for DDoS protection and resource management
# Used by: middleware/rate-limiter.js for request throttling

# Enable rate limiting middleware protection
# Validation: Boolean true/false
# Used by: middleware/rate-limiter.js for request throttling
RATE_LIMIT_ENABLED=true

# Rate limit time window in milliseconds (15 minutes = 900000ms)
# Validation: Positive integer in milliseconds
# Used by: middleware/rate-limiter.js for time window calculation
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per time window
# Validation: Positive integer
# Used by: middleware/rate-limiter.js for request counting
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Testing framework settings for Jest/Mocha automated testing
# Jest provides all-in-one testing solution, Mocha offers modular approach
# Used by: test scripts and configuration files

# Testing framework preference for automated testing
# Validation: Must be either 'jest' or 'mocha'
# Used by: test scripts and configuration files
TEST_FRAMEWORK=jest

# Test timeout in milliseconds for async operations
# Validation: Positive integer in milliseconds
# Used by: Jest and Mocha configuration files
TEST_TIMEOUT=30000

# Minimum code coverage percentage required
# Validation: Integer between 0-100
# Used by: test configuration for coverage validation
TEST_COVERAGE_THRESHOLD=90

# Port for test server instances to avoid conflicts
# Validation: Valid port number different from main PORT
# Used by: test files for creating isolated test servers
TEST_PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database settings (disabled for stateless tutorial architecture)
# This tutorial uses stateless architecture compatible with PM2 cluster mode
# Used by: config/database.js for educational documentation

# Database integration flag (tutorial uses stateless architecture)
# Validation: Boolean, should be false for stateless tutorial
# Used by: config/database.js for educational documentation
DATABASE_ENABLED=false

# Database type for future tutorial phases
# Validation: Must be 'none' for current stateless implementation
# Used by: config/database.js for educational planning
DATABASE_TYPE=none

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Application monitoring and health check settings
# Used by: monitoring/metrics.js, monitoring/health-check.js

# Enable application monitoring and metrics collection
# Validation: Boolean true/false
# Used by: monitoring/metrics.js and monitoring/health-check.js
MONITORING_ENABLED=true

# URL path for health check endpoint
# Validation: Valid URL path starting with /
# Used by: routes/health.js and monitoring/health-check.js
HEALTH_CHECK_ENDPOINT=/health

# Enable performance metrics collection
# Validation: Boolean true/false
# Used by: monitoring/metrics.js for performance tracking
METRICS_ENABLED=true

# Enable detailed performance monitoring
# Validation: Boolean true/false
# Used by: monitoring/performance.js for response time tracking
PERFORMANCE_MONITORING=true

# =============================================================================
# FLASK COMPATIBILITY CONFIGURATION
# =============================================================================
# Flask environment variables for cross-platform feature parity
# Maintains consistency between Node.js Express and Flask implementations
# Used by: Flask migration scripts for environment consistency

# Flask environment for cross-platform feature parity
# Validation: Must match NODE_ENV for consistency
# Used by: Flask migration scripts for environment consistency
FLASK_ENV=development

# Flask debug mode flag for development
# Validation: Boolean true/false, should match development settings
# Used by: Flask application configuration
FLASK_DEBUG=false

# Flask secret key for session management (empty for stateless)
# ⚠️  SECURITY SENSITIVE: Can be empty for stateless tutorial implementation
# Validation: Can be empty for stateless tutorial implementation
# Used by: Flask application for session security
FLASK_SECRET_KEY=

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development-specific settings for debugging and hot reload
# Used by: utils/logger.js, config/environment.js, development scripts

# Enable debug mode for development environment
# Validation: Boolean, typically true for development
# Used by: utils/logger.js and config/environment.js
DEBUG_MODE=true

# Enable hot reload for development (handled by nodemon)
# Validation: Boolean true/false
# Used by: development scripts and configuration
HOT_RELOAD=false

# Enable verbose logging for debugging
# Validation: Boolean, useful for development debugging
# Used by: utils/logger.js for detailed log output
VERBOSE_LOGGING=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# 
# Configuration loaded by: config/environment.js
# Validation performed by: config/index.js during application initialization
# Security validation by: config/security.js validateSecurityConfig function
# 
# For production deployment:
# 1. Copy this file to .env.production
# 2. Update values for production environment
# 3. Ensure proper file permissions (readable only by application user)
# 4. Consider encrypting sensitive values
# 
# Loading precedence: CLI arguments > process.env > .env file > default values
# =============================================================================