# ==============================================================================
# FLASK APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Flask application environment variables for cross-platform Node.js tutorial 
# project's Flask implementation. This file provides environment-specific 
# settings loaded by python-dotenv and consumed by Flask configuration classes 
# to maintain complete feature parity with the Express.js implementation.
#
# File Format: Standard .env file syntax compatible with python-dotenv
# Encoding: UTF-8 text file with Unix line endings
# Version Control: This file should be excluded from version control for security
# Precedence: Environment variables override .env file values
# ==============================================================================

# ==============================================================================
# FLASK CORE CONFIGURATION
# ==============================================================================
# Flask application core settings for environment mode, debug capabilities,
# application discovery, and security key management

# Flask application environment mode determining configuration class selection
# Valid options: development, production, testing, staging
# Cross-platform equivalent: NODE_ENV in Express.js implementation
# Affects: Debug mode, Logging level, Security settings, Configuration class selection
FLASK_ENV=development

# Enable Flask debug mode with auto-reload and detailed error pages
# Security Critical: Must be False in production for security
# Development Value: True for auto-reload and interactive debugger
# Features: Auto-reload on code changes, Detailed error tracebacks, Interactive debugger
FLASK_DEBUG=True

# Flask application module for CLI discovery and application factory
# Flask CLI Integration: Used by 'flask run' command for application location
# Application Factory: Points to create_app application factory function
FLASK_APP=app.py

# Flask secret key for session management, CSRF protection, and secure cookies
# Security Critical: Development-only value - must be changed for production
# Production Requirement: Generate using secrets.token_urlsafe(32) for production deployment
SECRET_KEY=tutorial-flask-secret-key-development-only-change-in-production

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# HTTP server configuration for Flask application binding and development server

# HTTP server port for Flask application - maintains Express.js feature parity
# Cross-platform requirement: Identical to Express.js port 3000 for API compatibility
# Testing integration: Used by cross-platform test suites for endpoint validation
PORT=3000

# Server host address for Flask application binding
# Development value: localhost for local development
# Production recommendation: 0.0.0.0 for production external access
HOST=localhost

# Flask development server host automatically used by 'flask run' command
# Flask CLI integration: Automatically discovered by Flask CLI development server
FLASK_RUN_HOST=localhost

# Flask development server port automatically used by 'flask run' command
# Cross-platform parity: Maintains identical behavior with Express.js development server
FLASK_RUN_PORT=3000

# ==============================================================================
# SECURITY CONFIGURATION - FLASK-TALISMAN (HELMET.JS EQUIVALENT)
# ==============================================================================
# Flask-Talisman security configuration equivalent to Helmet.js 15 sub-middlewares
# providing comprehensive HTTP security protection

# Force HTTPS for all requests using Flask-Talisman equivalent to Helmet.js HSTS
# Helmet.js equivalent: Strict-Transport-Security header configuration
# Development value: False for local development
# Production requirement: True for production HTTPS enforcement
TALISMAN_FORCE_HTTPS=False

# Content Security Policy default source directive for XSS prevention
# Security function: Prevents cross-site scripting attacks through content restriction
# Helmet.js equivalent: Content-Security-Policy configuration in Helmet.js
CSP_DEFAULT_SRC='self'

# Content Security Policy script source directive
# Development value: 'self' 'unsafe-inline' for development flexibility
# Production recommendation: 'self' only for maximum security
CSP_SCRIPT_SRC='self' 'unsafe-inline'

# Allowed CORS origins for cross-origin requests - comma-separated list
# Development purpose: Allow local development clients and testing tools
# Express.js equivalent: CORS middleware origin configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting requests per minute per IP address for DoS prevention
# Development value: 1000 for testing flexibility
# Production recommendation: 60 for production protection
RATE_LIMIT_PER_MINUTE=1000

# Path to SSL certificate file for HTTPS configuration
# Conditional requirement: Required when TALISMAN_FORCE_HTTPS=True
SSL_CERT_PATH=./certificates/server.crt

# Path to SSL private key file for HTTPS configuration
# Security requirement: Private key must be protected with appropriate file permissions
SSL_KEY_PATH=./certificates/server.key

# ==============================================================================
# WSGI DEPLOYMENT CONFIGURATION (PM2 EQUIVALENT)
# ==============================================================================
# Gunicorn WSGI server configuration equivalent to PM2 cluster mode providing
# x10 performance increase through multi-worker deployment

# Number of Gunicorn worker processes equivalent to PM2 cluster instances
# PM2 equivalent: Similar to PM2 instances: 'max' providing x10 performance increase
# Optimization: Should match number of CPU cores for optimal performance
GUNICORN_WORKERS=4

# Gunicorn bind address and port for production server
# Production purpose: Production server binding for external access
GUNICORN_BIND=0.0.0.0:3000

# Gunicorn worker timeout in seconds for request handling
# Performance tuning: Adjust based on expected request processing time
GUNICORN_TIMEOUT=30

# Maximum requests per worker before restart for memory management
# PM2 equivalent: Similar to PM2 max_memory_restart functionality
GUNICORN_MAX_REQUESTS=1000

# Enable WSGI server auto-reload on code changes
# Development recommendation: True for development productivity
# Production requirement: False for production stability
WSGI_AUTO_RELOAD=False

# ==============================================================================
# TESTING CONFIGURATION
# ==============================================================================
# Flask testing environment configuration with coverage thresholds and
# test isolation settings

# Enable Flask testing mode with test-specific behavior
# Testing value: True when running test suites
# Test isolation: Enables test-specific configuration and disables features
TESTING=False

# Minimum test coverage percentage required for quality gates
# Requirement: ≥ 90% code coverage target from technical specifications
# Jest/Mocha equivalent: Equivalent to Jest and Mocha coverage threshold
COVERAGE_THRESHOLD=90

# Database URL for testing environment using in-memory database
# Test isolation: In-memory database prevents test data contamination
TEST_DATABASE_URL=sqlite:///:memory:

# pytest timeout in seconds for individual test execution
# Jest/Mocha equivalent: Equivalent to Jest and Mocha test timeout configuration
PYTEST_TIMEOUT=10

# Port for test server - 0 enables random port assignment
# Test isolation: Random port prevents conflicts during parallel test execution
TEST_PORT=0

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Python logging configuration for Flask application and WSGI server
# equivalent to Express.js logging middleware and PM2 log management

# Application logging level for Flask application and WSGI server
# Development value: DEBUG for detailed development information
# Production value: ERROR for production performance
LOG_LEVEL=INFO

# Python logging format string for structured log messages
# Express.js equivalent: Equivalent to Express.js logging middleware format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Path to log file for production logging and monitoring
# PM2 equivalent: Similar to PM2 log file management and rotation
LOG_FILE_PATH=./logs/flask-app.log

# Maximum log file size before rotation
# Log management: Prevents excessive disk usage through automatic rotation
LOG_ROTATION_SIZE=10MB

# ==============================================================================
# CROSS-PLATFORM PARITY CONFIGURATION
# ==============================================================================
# Environment variables ensuring identical response formats and status codes
# between Node.js and Flask implementations for educational demonstration

# Port verification for cross-platform testing and feature parity
# Validation purpose: Ensures identical port usage with Express.js implementation
NODE_JS_EQUIVALENT_PORT=3000

# Response message for /hello endpoint to match Node.js Express exactly
# Feature parity: Identical response format to Express.js /hello endpoint
HELLO_ENDPOINT_RESPONSE=Hello world

# Response message for /good-evening endpoint to match Node.js Express exactly
# API compatibility: Ensures response parity for cross-platform validation
GOOD_EVENING_ENDPOINT_RESPONSE=Good evening

# Enable Express.js compatibility features and response formats
# Response formatting: Ensures JSON responses match Express.js format exactly
EXPRESS_JS_COMPATIBILITY_MODE=True

# ==============================================================================
# DEVELOPMENT CONFIGURATION
# ==============================================================================
# Development-specific features and debugging tools for Flask application
# equivalent to nodemon auto-restart and development productivity features

# Enable automatic reloading of Flask development server on code changes
# Development productivity: Automatically restarts server when Python files change
# Express.js equivalent: Similar to nodemon auto-restart functionality
FLASK_RUN_RELOAD=True

# Additional files to watch for auto-reload beyond Python files
# Format: Comma-separated file paths or glob patterns
FLASK_RUN_EXTRA_FILES=

# Enable development-specific features and debugging tools
# Features: Enhanced error pages, Debug toolbar, Permissive CORS
DEVELOPMENT_FEATURES=True

# Include debug information in HTTP response headers
# Security requirement: Must be False in production for security
DEBUG_HEADERS=True

# ==============================================================================
# PRODUCTION CONFIGURATION
# ==============================================================================
# Production-specific optimizations and security hardening equivalent to
# PM2 cluster mode memory optimization and performance tuning

# Enable production-specific optimizations and security hardening
# Production value: True for production deployment
PRODUCTION_MODE=False

# Preload application before forking workers for memory efficiency
# PM2 equivalent: Similar to PM2 cluster mode memory optimization
PRELOAD_APP=True

# Maximum number of simultaneous connections per worker
# Performance tuning: Adjust based on expected concurrent load
WORKER_CONNECTIONS=1000

# HTTP keepalive timeout in seconds for connection reuse
# Performance optimization: Connection reuse improves performance
KEEPALIVE_TIMEOUT=5

# ==============================================================================
# ENVIRONMENT VARIABLE USAGE NOTES
# ==============================================================================
# 
# Python-dotenv Loading:
# - python-dotenv automatically discovers .env files in current and parent directories
# - Flask CLI automatically loads .env files before starting application
# - Environment variables override .env file values
#
# Flask Config Integration:
# - Environment variables accessed through Flask configuration classes
# - Loaded during Flask application factory initialization
# - Runtime modification possible for testing
#
# Cross-Platform Validation:
# - Cross-platform test suites validate identical responses using environment settings
# - Environment variables ensure consistent behavior with Express.js implementation
#
# Security Considerations:
# - Development-only SECRET_KEY - must be changed to cryptographically secure random value in production
# - Debug mode enabled for development - must be False in production
# - SSL certificates required for HTTPS enforcement in production
# - CORS origins allow localhost for development - restrict to actual domains in production
# - Environment file should have restricted read permissions (600) in production
#
# Integration Points:
# - config.py: Loaded by Flask configuration classes for environment-specific settings
# - app.py: Used by Flask application factory during Flask application creation
# - Flask CLI: Automatically loaded by Flask CLI commands including 'flask run'
# - Testing framework: Test-specific environment variables loaded during pytest execution
# - WSGI deployment: Production environment variables used by Gunicorn WSGI server configuration
# - Cross-platform testing: Variables used by integration tests for Node.js/Flask feature parity validation
#
# Educational Value:
# - Demonstrates Flask environment configuration patterns equivalent to Node.js Express environment management
# - Shows cross-platform feature parity maintenance through consistent environment variable configuration
# - Illustrates Flask-Talisman security configuration equivalent to Helmet.js comprehensive security protection
# - Demonstrates WSGI deployment environment setup equivalent to PM2 cluster mode multi-worker configuration
# - Shows Flask testing environment configuration with coverage thresholds and test isolation
# - Demonstrates Python logging configuration equivalent to Node.js console logging and PM2 log management
# - Illustrates Flask development workflow with auto-reload equivalent to nodemon development productivity
# - Shows production-ready Flask environment configuration with security hardening and performance optimization
#
# ==============================================================================