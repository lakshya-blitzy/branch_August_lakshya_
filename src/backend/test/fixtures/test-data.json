{
  "httpEndpoints": {
    "hello": {
      "method": "GET",
      "path": "/hello",
      "expectedResponse": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "X-Powered-By": null
        },
        "body": {
          "message": "Hello world"
        }
      },
      "testScenarios": [
        {
          "name": "successful_hello_request",
          "description": "Valid GET request to /hello endpoint",
          "input": {
            "method": "GET",
            "path": "/hello",
            "headers": {}
          },
          "expected": {
            "statusCode": 200,
            "responseTime": "<100ms",
            "contentType": "application/json"
          }
        },
        {
          "name": "hello_with_query_params",
          "description": "GET request to /hello with query parameters",
          "input": {
            "method": "GET",
            "path": "/hello?param=value",
            "headers": {}
          },
          "expected": {
            "statusCode": 200,
            "responseTime": "<100ms"
          }
        }
      ]
    },
    "goodEvening": {
      "method": "GET",
      "path": "/good-evening",
      "expectedResponse": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
