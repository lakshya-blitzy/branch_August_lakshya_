        "endpoint": "/health"
      },
      "memoryMonitoring": {
        "checkInterval": 30000,
        "restartThreshold": "1G",
        "alertThreshold": "800M"
      },
      "cpuMonitoring": {
        "checkInterval": 10000,
        "alertThreshold": 80,
        "sustainedDuration": 60000
      }
    },
    "loadBalancing": {
      "algorithm": "round-robin",
      "enableStickySessions": false,
      "healthCheckEnabled": true,
      "failoverTimeout": 5000,
      "loadBalancerMetrics": {
        "requestDistribution": "even",
