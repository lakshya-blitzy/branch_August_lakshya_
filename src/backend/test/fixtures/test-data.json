  "errorScenarios": {
    "httpErrors": {
      "notFound": {
        "request": {
          "method": "GET",
          "path": "/nonexistent"
        },
        "expectedResponse": {
          "statusCode": 404,
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "Not Found",
            "message": "Cannot GET /nonexistent",
            "statusCode": 404
          }
        }
      },
      "methodNotAllowed": {
        "request": {
          "method": "POST",
          "path": "/hello"
        },
        "expectedResponse": {
          "statusCode": 405,
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "Method Not Allowed",
            "message": "Method POST not allowed",
            "statusCode": 405
          }
        }
      },
      "badRequest": {
        "request": {
          "method": "GET",
          "path": "/hello",
          "headers": {
            "content-type": "invalid-content-type"
          }
        },
        "expectedResponse": {
          "statusCode": 400,
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "Bad Request",
            "statusCode": 400
          }
        }
      }
    },
    "validationErrors": {
      "invalidPath": {
        "scenarios": [
          {
            "path": "/../etc/passwd",
            "expectedStatus": 404,
            "description": "Path traversal attempt"
          },
          {
            "path": "/hello%00",
            "expectedStatus": 400,
            "description": "Null byte injection"
          },
          {
            "path": "/hello" + "A".repeat(2048),
            "expectedStatus": 414,
            "description": "URI too long"
          }
        ]
      },
      "invalidHeaders": {
        "scenarios": [
          {
            "headers": {
              "content-length": "-1"
            },
            "expectedStatus": 400,
            "description": "Invalid content length"
          },
          {
            "headers": {
              "host": "evil.example.com"
            },
            "expectedStatus": 400,
            "description": "Host header injection"
          }
        ]
      }
    },
    "serverErrors": {
      "internalServerError": {
        "trigger": "force_error",
        "expectedResponse": {
          "statusCode": 500,
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "Internal Server Error",
            "statusCode": 500
          }
        }
      },
      "serviceUnavailable": {
        "trigger": "overload_server",
        "expectedResponse": {
          "statusCode": 503,
          "headers": {
            "retry-after": "60"
          },
          "body": {
            "error": "Service Unavailable",
            "statusCode": 503
          }
        }
      }
    }
  },
