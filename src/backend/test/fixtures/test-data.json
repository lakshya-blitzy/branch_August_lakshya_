  "testEnvironments": {
    "development": {
      "nodeEnv": "development",
      "port": 3000,
      "logLevel": "debug",
      "enableCors": true,
      "security": {
        "helmetEnabled": true,
        "httpsRedirect": false,
        "contentSecurityPolicy": {
          "reportOnly": true
        }
      },
      "performance": {
        "responseTimeTarget": 100,
        "memoryLimitMB": 100,
        "cpuThreshold": 80
      },
      "database": {
        "enabled": false,
        "connectionString": null
      }
    },
    "production": {
      "nodeEnv": "production",
      "port": 3000,
      "logLevel": "info",
      "enableCors": false,
      "security": {
        "helmetEnabled": true,
        "httpsRedirect": true,
        "contentSecurityPolicy": {
          "reportOnly": false,
          "directives": {
            "defaultSrc": ["'self'"],
            "scriptSrc": ["'self'"],
            "styleSrc": ["'self'", "'unsafe-inline'"],
            "imgSrc": ["'self'", "data:", "https:"],
            "objectSrc": ["'none'"]
          }
        }
      },
      "performance": {
        "responseTimeTarget": 50,
        "memoryLimitMB": 150,
        "cpuThreshold": 70
      },
      "database": {
        "enabled": false,
        "connectionString": null
      }
    },
    "testing": {
      "nodeEnv": "test",
      "port": 0,
      "logLevel": "silent",
      "enableCors": true,
      "security": {
        "helmetEnabled": true,
        "httpsRedirect": false,
        "contentSecurityPolicy": {
          "reportOnly": true
        }
      },
      "performance": {
        "responseTimeTarget": 200,
        "memoryLimitMB": 200,
        "cpuThreshold": 90
      },
      "database": {
        "enabled": false,
        "connectionString": null
      },
      "testing": {
        "timeout": 10000,
