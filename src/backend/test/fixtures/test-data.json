        "failoverTime": "<5s"
      },
      "performanceExpectations": {
        "scalabilityFactor": 10,
        "cpuCores": "all",
        "performanceIncrease": "linear"
      }
    }
  },
  "validationRules": {
    "httpValidation": {
      "requestValidation": {
        "allowedMethods": ["GET", "HEAD", "OPTIONS"],
        "maxPathLength": 2048,
        "maxHeaderSize": 8192,
        "requiredHeaders": {
          "host": true,
          "user-agent": false
        }
      },
      "responseValidation": {
        "requiredHeaders": {
          "content-type": true,
          "content-length": false,
          "date": true
        },
        "statusCodeRanges": {
          "success": [200, 299],
          "clientError": [400, 499],
          "serverError": [500, 599]
        },
        "responseTimeThresholds": {
          "fast": 50,
          "acceptable": 100,
          "slow": 200
        }
      },
      "endpointValidation": {
        "hello": {
          "method": "GET",
          "responseType": "application/json",
          "requiredFields": ["message"],
          "maxResponseTime": 100
        },
        "goodEvening": {
          "method": "GET",
          "responseType": "application/json",
          "requiredFields": ["message"],
          "maxResponseTime": 100
        },
        "health": {
          "method": "GET",
          "responseType": "application/json",
          "requiredFields": ["status", "timestamp", "uptime", "environment"],
          "maxResponseTime": 50
        }
      }
    },
    "securityValidation": {
      "headerValidation": {
        "requiredSecurityHeaders": [
          "Content-Security-Policy",
          "Strict-Transport-Security",
          "X-Content-Type-Options",
          "X-Frame-Options",
          "Referrer-Policy"
        ],
        "forbiddenHeaders": [
          "X-Powered-By",
          "Server"
        ],
        "headerPatterns": {
          "strictTransportSecurity": "max-age=\\d+",
          "contentSecurityPolicy": "default-src\\s+[^;]+",
          "xFrameOptions": "(DENY|SAMEORIGIN|ALLOW-FROM\\s+\\S+)"
        }
      },
      "contentValidation": {
        "allowedContentTypes": [
          "application/json",
          "text/plain",
          "text/html"
        ],
        "blockedPatterns": [
          "<script[^>]*>.*?</script>",
          "javascript:",
          "data:text/html",
          "vbscript:"
        ]
      },
      "vulnerabilityChecks": {
        "xssProtection": {
          "checkInputSanitization": true,
          "checkOutputEncoding": true,
          "checkContentSecurityPolicy": true
        },
        "clickjackingProtection": {
          "checkXFrameOptions": true,
          "checkContentSecurityPolicy": true
        },
        "informationDisclosure": {
          "checkErrorMessages": true,
          "checkServerHeaders": true,
          "checkVersionDisclosure": false
        }
      }
    },
    "performanceValidation": {
      "responseTimeValidation": {
        "endpoints": {
          "hello": {
            "target": 50,
            "warning": 75,
            "critical": 100
          },
          "goodEvening": {
            "target": 50,
            "warning": 75,
            "critical": 100
          },
          "health": {
            "target": 25,
            "warning": 40,
            "critical": 50
          }
        },
        "measurementMethod": "percentile95",
        "sampleSize": 100
      },
      "resourceValidation": {
        "memoryUsage": {
          "perProcess": {
            "target": 50,
            "warning": 75,
            "critical": 100,
            "unit": "MB"
          },
          "total": {
            "target": 200,
            "warning": 300,
            "critical": 500,
            "unit": "MB"
          }
        },
        "cpuUsage": {
          "target": 70,
          "warning": 80,
          "critical": 90,
          "unit": "percent",
          "measurementDuration": 60
        }
      },
      "loadTestingValidation": {
        "concurrentUsers": {
          "minimum": 100,
          "target": 500,
          "maximum": 1000
        },
        "requestsPerSecond": {
          "minimum": 1000,
          "target": 5000,
          "maximum": 10000
        },
        "testDuration": {
          "rampUp": 30,
          "steady": 300,
          "rampDown": 30,
          "unit": "seconds"
        }
      }
    }
  }
