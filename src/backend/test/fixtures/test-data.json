        }
      }
    }
  },
  "pm2TestData": {
    "clusterConfig": {
      "name": "tutorial-app",
      "script": "./server.js",
      "instances": "max",
      "execMode": "cluster",
      "autorestart": true,
      "watch": false,
      "maxMemoryRestart": "1G",
      "env": {
        "NODE_ENV": "development",
        "PORT": 3000
      },
      "envProduction": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "logFile": "./logs/combined.log",
      "outFile": "./logs/out.log",
      "errorFile": "./logs/error.log",
      "logDateFormat": "YYYY-MM-DD HH:mm Z",
      "mergeLogsOnRestart": false
    },
    "processMetrics": {
