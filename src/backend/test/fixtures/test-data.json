        },
        "body": {
          "message": "Good evening"
        }
      },
      "testScenarios": [
        {
          "name": "successful_good_evening_request",
          "description": "Valid GET request to /good-evening endpoint",
          "input": {
            "method": "GET",
            "path": "/good-evening",
            "headers": {}
          },
          "expected": {
            "statusCode": 200,
            "responseTime": "<100ms",
            "contentType": "application/json"
          }
        }
      ]
    },
    "health": {
      "method": "GET",
      "path": "/health",
      "expectedResponse": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "body": {
          "status": "OK",
          "timestamp": "2025-01-01T00:00:00.000Z",
          "uptime": 123.456,
          "environment": "development"
        }
      },
      "testScenarios": [
        {
          "name": "health_check_successful",
          "description": "Valid health check request",
          "input": {
            "method": "GET",
