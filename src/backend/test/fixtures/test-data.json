  },
  "securityTestData": {
    "helmetHeaders": {
      "contentSecurityPolicy": {
        "expected": "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests",
        "description": "Content Security Policy header for XSS prevention"
      },
      "crossOriginEmbedderPolicy": {
        "expected": "require-corp",
        "description": "Cross-Origin Embedder Policy header"
      },
      "crossOriginOpenerPolicy": {
        "expected": "same-origin",
        "description": "Cross-Origin Opener Policy header"
      },
      "crossOriginResourcePolicy": {
        "expected": "cross-origin",
        "description": "Cross-Origin Resource Policy header"
      },
      "originAgentCluster": {
        "expected": "?1",
        "description": "Origin Agent Cluster header"
      },
      "referrerPolicy": {
        "expected": "no-referrer",
        "description": "Referrer Policy header"
      },
      "strictTransportSecurity": {
        "expected": "max-age=31536000; includeSubDomains",
        "description": "Strict Transport Security header for HTTPS enforcement"
      },
      "xContentTypeOptions": {
        "expected": "nosniff",
        "description": "X-Content-Type-Options header"
      },
      "xDnsPrefetchControl": {
        "expected": "off",
        "description": "X-DNS-Prefetch-Control header"
      },
      "xDownloadOptions": {
        "expected": "noopen",
        "description": "X-Download-Options header"
      },
      "xFrameOptions": {
        "expected": "SAMEORIGIN",
        "description": "X-Frame-Options header for clickjacking prevention"
      },
      "xPermittedCrossDomainPolicies": {
        "expected": "none",
        "description": "X-Permitted-Cross-Domain-Policies header"
      },
      "xPoweredBy": {
        "expected": null,
        "description": "X-Powered-By header should be removed"
      },
      "xXssProtection": {
        "expected": "0",
        "description": "X-XSS-Protection header disabled for modern browsers"
      }
    },
    "xssAttacks": [
      {
        "name": "script_injection",
        "payload": "<script>alert('xss')</script>",
        "expectedBlocking": true,
        "description": "Basic script tag injection attempt"
      },
      {
        "name": "javascript_protocol",
        "payload": "javascript:alert('xss')",
        "expectedBlocking": true,
        "description": "JavaScript protocol injection"
      },
      {
        "name": "event_handler_injection",
        "payload": "<img src=x onerror=alert('xss')>",
        "expectedBlocking": true,
        "description": "Event handler based XSS"
      },
      {
        "name": "svg_xss",
        "payload": "<svg onload=alert('xss')>",
        "expectedBlocking": true,
        "description": "SVG-based XSS attack"
      }
    ],
    "cspViolations": [
      {
        "violation": "script-src",
        "source": "unsafe-inline",
        "expected": "blocked",
        "description": "Inline script execution should be blocked"
      },
      {
        "violation": "script-src",
        "source": "unsafe-eval",
        "expected": "blocked",
        "description": "eval() usage should be blocked"
      },
      {
        "violation": "object-src",
        "source": "data:",
        "expected": "blocked",
        "description": "Object embedding should be blocked"
      }
    ],
    "securityHeaders": {
      "requiredHeaders": [
        "Content-Security-Policy",
        "Strict-Transport-Security",
        "X-Content-Type-Options",
        "X-Frame-Options",
        "Referrer-Policy"
      ],
      "forbiddenHeaders": [
        "X-Powered-By",
        "Server"
      ],
      "headerValidation": {
        "strictTransportSecurity": {
          "pattern": "max-age=\\d+",
          "minAge": 31536000
        },
        "contentSecurityPolicy": {
          "requiredDirectives": ["default-src", "script-src", "object-src"]
        }
      }
    }
  },
