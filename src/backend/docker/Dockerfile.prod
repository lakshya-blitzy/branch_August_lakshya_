# =============================================================================
# PRODUCTION-OPTIMIZED DOCKERFILE FOR NODE.JS TUTORIAL PROJECT
# Multi-stage build with comprehensive security hardening, PM2 cluster mode,
# and enterprise-grade deployment practices for Node.js v22.x LTS with Express.js v5.1.0
# =============================================================================
#
# Features:
# - Multi-stage build optimization for minimal production image size
# - Comprehensive container security hardening with non-root user execution
# - PM2 cluster mode deployment with zero-downtime capabilities
# - Alpine Linux base for minimal attack surface and security
# - Advanced health monitoring and container orchestration compatibility
# - Production-ready logging, monitoring, and process management
# - Enterprise-grade deployment practices and security compliance
#
# Build Command:
# docker build -f docker/Dockerfile.prod -t nodejs-tutorial-prod:latest .
#
# Run Command:
# docker run -d --name nodejs-tutorial-app -p 3000:3000 \
#   --restart unless-stopped \
#   --health-cmd="node scripts/health-check.js --type quick --format json || exit 1" \
#   --health-interval=30s --health-timeout=5s --health-retries=3 \
#   nodejs-tutorial-prod:latest
#
# Version: 1.0.0
# Node.js: v22.x LTS (Active LTS support extending into late 2025)
# Express.js: v5.1.0 (Enhanced security features and ReDoS protection)
# PM2: v6.0.8 (Production process management with built-in load balancer)
# Alpine: Latest (Minimal base image with security updates)
#
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: DEPENDENCIES - Install and cache production dependencies
# Purpose: Optimize dependency installation with security scanning and caching
# -----------------------------------------------------------------------------
FROM node:22-alpine AS dependencies

# Set build-time labels for container metadata and traceability
LABEL stage="dependencies" \
      description="Production dependency installation with security scanning" \
      maintainer="Node.js Tutorial Project Team" \
      version="1.0.0" \
      nodejs.version="22.x-lts" \
      alpine.version="latest"

# Create application directory with proper ownership for security
WORKDIR /app

# Copy package files for dependency resolution and installation
# Leverage Docker layer caching by copying package files first
COPY package*.json ./

# Install production dependencies with comprehensive security measures
# - Use npm ci for reproducible builds and faster installation
# - Install only production dependencies to minimize attack surface
# - Run security audit to detect vulnerabilities
# - Clean npm cache to reduce image size
RUN set -eux; \
    # Update package index for latest security patches
    apk update && \
    # Install production dependencies with audit
    npm ci --only=production --audit && \
    # Run security audit with moderate level threshold
    npm audit --audit-level moderate || true && \
    # Clean npm cache and temporary files for minimal image size
    npm cache clean --force && \
    # Remove temporary installation artifacts
    rm -rf /tmp/* /var/tmp/* /root/.npm /root/.cache

# -----------------------------------------------------------------------------
# STAGE 2: SECURITY - Apply comprehensive security hardening measures
# Purpose: System updates, security patches, and non-root user configuration
# -----------------------------------------------------------------------------
FROM node:22-alpine AS security

# Set security-focused build labels and metadata
LABEL stage="security" \
      description="Security hardening with system updates and user configuration" \
      security.non-root="true" \
      security.user="nodejs" \
      security.uid="1001" \
      security.gid="1001"

# Apply comprehensive system security updates and install required packages
# - Update all system packages to latest versions for security patches
# - Install dumb-init for proper signal handling and zombie process prevention
# - Remove package cache to minimize image size
RUN set -eux; \
    # Update package repository and upgrade all packages
    apk update && apk upgrade && \
    # Install dumb-init for proper process management in containers
    apk add --no-cache dumb-init && \
    # Remove package cache to reduce attack surface
    rm -rf /var/cache/apk/*

# Install PM2 globally for production process management
# PM2 provides cluster mode, load balancing, and zero-downtime deployment
RUN set -eux; \
    # Install latest PM2 with production optimizations
    npm install -g pm2@latest && \
    # Clean npm cache to reduce image size
    npm cache clean --force

# Create non-root user following security best practices
# Principle of Least Privilege: Container runs as non-root for security compliance
RUN set -eux; \
    # Create nodejs group with specific GID for consistency
    addgroup -g 1001 -S nodejs && \
    # Create nodejs user with specific UID and assign to nodejs group
    adduser -S nodejs -u 1001 -G nodejs

# Create application directory with proper ownership and permissions
WORKDIR /app
RUN chown -R nodejs:nodejs /app

# -----------------------------------------------------------------------------
# STAGE 3: PRODUCTION - Final production image with minimal attack surface
# Purpose: Secure, optimized production container with PM2 cluster mode
# -----------------------------------------------------------------------------
FROM security AS production

# Set comprehensive production image metadata and labels
LABEL stage="production" \
      description="Production-ready Node.js application with PM2 cluster mode" \
      application="nodejs-tutorial-project" \
      version="1.0.0" \
      nodejs.version="22.x-lts" \
      express.version="5.1.0" \
      pm2.version="6.0.8" \
      deployment.mode="production" \
      security.hardened="true" \
      cluster.mode="enabled" \
      zero-downtime="supported" \
      health-checks="enabled" \
      maintainer="Node.js Tutorial Project Team" \
      source="https://github.com/nodejs-tutorial/backend" \
      documentation="https://docs.nodejs-tutorial.com" \
      license="MIT"

# Set production environment variables for optimal configuration
# Configure Node.js, PM2, and application-specific settings
ENV NODE_ENV=production \
    PORT=3000 \
    PM2_PUBLIC_KEY='' \
    PM2_SECRET_KEY='' \
    PM2_CLUSTER_MODE=true \
    PM2_INSTANCES=max \
    PM2_LOAD_BALANCER=true \
    NODE_OPTIONS="--max-old-space-size=1024 --optimize-for-size" \
    NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_AUDIT_LEVEL=moderate

# Copy production dependencies from dependencies stage with proper ownership
# Leverage multi-stage build to include only production node_modules
COPY --from=dependencies --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy application files with proper ownership and security permissions
# Include only necessary files for production deployment
COPY --chown=nodejs:nodejs ecosystem.config.js package*.json ./
COPY --chown=nodejs:nodejs server.js app.js ./
COPY --chown=nodejs:nodejs config/ ./config/
COPY --chown=nodejs:nodejs utils/ ./utils/
COPY --chown=nodejs:nodejs middleware/ ./middleware/
COPY --chown=nodejs:nodejs routes/ ./routes/
COPY --chown=nodejs:nodejs services/ ./services/
COPY --chown=nodejs:nodejs controllers/ ./controllers/
COPY --chown=nodejs:nodejs scripts/health-check.js ./scripts/
COPY --chown=nodejs:nodejs monitoring/ ./monitoring/
COPY --chown=nodejs:nodejs pm2/ ./pm2/

# Create log directory with proper permissions for PM2 and application logging
RUN set -eux; \
    mkdir -p logs/pm2 logs/app && \
    chown -R nodejs:nodejs logs

# Switch to non-root user for security compliance
# Enforces Principle of Least Privilege throughout container execution
USER nodejs

# Expose application port for external access
# Port 3000 is the standard Node.js application port
EXPOSE 3000

# Configure comprehensive health check for container orchestration
# Supports Kubernetes liveness/readiness probes and Docker health monitoring
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node scripts/health-check.js --type quick --format json --timeout 5000 || exit 1

# Set up dumb-init for proper signal handling and PM2 runtime for production
# - dumb-init ensures proper Unix signal handling and prevents zombie processes
# - PM2 runtime provides cluster mode, load balancing, and process management
# - ecosystem.config.js contains comprehensive PM2 configuration
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start application using PM2 cluster mode with production configuration
# PM2 provides:
# - Cluster mode with automatic CPU core detection (max instances)
# - Built-in load balancer for request distribution
# - Zero-downtime deployment with graceful worker restart
# - Automatic restart on failures with exponential backoff
# - Comprehensive process monitoring and health tracking
# - Log management with rotation and centralized collection
CMD ["pm2-runtime", "start", "ecosystem.config.js", "--env", "production"]

# =============================================================================
# CONTAINER USAGE AND DEPLOYMENT EXAMPLES
# =============================================================================
#
# BUILD COMMANDS:
# 
# Standard production build:
# docker build -f docker/Dockerfile.prod -t nodejs-tutorial:latest .
#
# Build with custom tag and labels:
# docker build -f docker/Dockerfile.prod \
#   --label "build.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
#   --label "build.version=1.0.0" \
#   --label "git.commit=$(git rev-parse HEAD)" \
#   -t nodejs-tutorial:1.0.0 .
#
# Multi-platform build for ARM64 and AMD64:
# docker buildx build --platform linux/amd64,linux/arm64 \
#   -f docker/Dockerfile.prod -t nodejs-tutorial:latest .
#
# =============================================================================
#
# DEPLOYMENT COMMANDS:
#
# Basic production deployment:
# docker run -d --name nodejs-tutorial-app \
#   -p 3000:3000 \
#   --restart unless-stopped \
#   nodejs-tutorial:latest
#
# Production deployment with resource limits:
# docker run -d --name nodejs-tutorial-app \
#   -p 3000:3000 \
#   --restart unless-stopped \
#   --memory="1g" \
#   --cpus="2.0" \
#   --health-cmd="node scripts/health-check.js --type quick || exit 1" \
#   --health-interval=30s \
#   --health-timeout=5s \
#   --health-retries=3 \
#   nodejs-tutorial:latest
#
# Production deployment with environment configuration:
# docker run -d --name nodejs-tutorial-app \
#   -p 3000:3000 \
#   --restart unless-stopped \
#   --env NODE_ENV=production \
#   --env PORT=3000 \
#   --env PM2_INSTANCES=max \
#   --volume /var/log/nodejs-tutorial:/app/logs \
#   nodejs-tutorial:latest
#
# =============================================================================
#
# DOCKER COMPOSE DEPLOYMENT:
#
# version: '3.8'
