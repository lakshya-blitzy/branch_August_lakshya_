{
  "name": "nodejs-tutorial-backend",
  "version": "1.0.0",
  "description": "Comprehensive Node.js tutorial project demonstrating progressive web application development from basic HTTP server to production-ready Express.js deployment with PM2 cluster mode, comprehensive testing, and cross-platform Flask migration comparison.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2-dev server.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete all",
    "pm2:save": "pm2 save",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:startup": "pm2 startup",
    "pm2:unstartup": "pm2 unstartup",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:mocha": "mocha test/**/*.test.js --recursive",
    "test:mocha:watch": "mocha test/**/*.test.js --recursive --watch",
    "test:mocha:coverage": "c8 mocha test/**/*.test.js --recursive",
    "test:performance": "autocannon http://localhost:3000/health -c 10 -d 10",
    "test:load": "artillery quick --count 10 --num 25 http://localhost:3000/health",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "security:check": "npm audit --audit-level moderate",
    "build": "node scripts/build.js",
    "build:production": "NODE_ENV=production node scripts/build.js",
    "clean": "node scripts/cleanup.js",
    "setup": "node scripts/setup.js",
    "health": "node scripts/health-check.js",
    "deploy": "node scripts/deploy.js",
    "deploy:production": "NODE_ENV=production pm2 start ecosystem.config.js --env production",
    "deploy:staging": "NODE_ENV=staging pm2 start ecosystem.config.js --env staging",
    "prestart": "npm run health",
    "postinstall": "node scripts/postinstall.js || echo 'No postinstall script'",
    "flask:setup": "python scripts/flask/setup.py",
    "flask:start": "python scripts/flask/start.py",
    "flask:test": "python scripts/flask/test.py",
    "flask:compare": "node scripts/flask/compare.js",
    "docs:generate": "jsdoc -c jsdoc.config.json",
    "docs:serve": "http-server docs -p 8080",
    "monitor": "pm2 monit",
    "logs": "pm2 logs --lines 50",
    "status": "pm2 status",
    "restart": "pm2 restart all"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.1",
    "express-slow-down": "^2.0.3",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "validator": "^13.11.0",
    "rate-limit-redis": "^4.2.0",
    "on-headers": "^1.0.2",
    "on-finished": "^2.4.1",
    "chalk": "^5.3.0",
    "async": "^3.2.5",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "axios": "^1.6.0",
    "deep-equal": "^2.2.0",
    "uuid": "^9.0.0",
    "bleach": "^6.1.0",
    "email-validator": "^2.1.0",
    "validators": "^0.22.0",
    "jsonschema": "^4.20.0"
  },
  "devDependencies": {
    "pm2": "^6.0.8",
    "jest": "^29.7.0",
    "mocha": "^11.0.0",
    "chai": "^5.1.1",
    "sinon": "^18.0.1",
    "supertest": "^7.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "nodemon": "^3.1.7",
    "c8": "^10.1.2",
    "nyc": "^17.1.0",
    "artillery": "^2.0.20",
    "autocannon": "^7.15.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.0.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.0",
    "@faker-js/faker": "^9.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@eslint/js": "^9.15.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-import": "^2.30.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "@nearform/clinic": "^12.0.0",
    "cross-spawn": "^7.0.0",
    "glob": "^11.0.0",
    "rimraf": "^5.0.0",
    "psutil": "^5.9.0",
    "@types/mocha": "^10.0.0",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "eslint-plugin-mocha": "^10.5.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "expect": "^29.0.0",
    "pytest-mock": "^3.11.1",
    "deepdiff": "^6.7.0",
    "freezegun": "^1.2.0",
    "factory-boy": ">=3.3.0,<4.0.0",
    "watchdog": ">=3.0.0,<4.0.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "pm2",
    "jest",
    "helmet",
    "production",
    "deployment",
    "testing",
    "security",
    "cluster",
    "educational",
    "backend",
    "server",
    "api",
    "rest",
    "middleware",
    "monitoring",
    "logging",
    "performance",
    "scaling",
    "load-balancing",
    "zero-downtime",
    "graceful-shutdown",
    "health-checks",
    "cross-platform",
    "flask-migration",
    "es-modules",
    "modern-javascript",
    "lts",
    "enterprise",
    "best-practices"
  ],
  "author": "Node.js Tutorial Project Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodejs-tutorial/backend.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs-tutorial/backend/issues"
  },
  "homepage": "https://github.com/nodejs-tutorial/backend#readme",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/",
    "config/",
    "scripts/",
    "ecosystem.config.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directories": {
    "test": "test",
    "lib": "src",
    "doc": "docs"
  },
  "preferGlobal": false,
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}