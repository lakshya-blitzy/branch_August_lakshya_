{
  "name": "nodejs-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial project - minimal testing setup",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.simple.js",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.simple.js --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.simple.js --coverage"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.0.3",
    "express": "4.18.2",
    "express-rate-limit": "7.1.0",
    "helmet": "7.1.0",
    "on-headers": "1.0.2",
    "rate-limit-redis": "4.2.0",
    "winston": "3.8.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "axios": "^1.11.0",
    "deep-equal": "^2.2.3",
    "jest": "29.3.1",
    "sinon": "^18.0.1",
    "supertest": "6.3.3",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
