  "testScenarios": {
    "happyPath": {
      "description": "Normal server operations with valid requests",
      "scenarios": [
        {
          "name": "GET root endpoint",
          "method": "GET",
          "path": "/",
          "expectedStatus": 200,
          "expectedHeaders": {"content-type": "application/json"},
          "maxResponseTime": 100
        },
        {
          "name": "POST valid data",
          "method": "POST",
          "path": "/data",
          "body": {"name": "test", "value": 123},
          "expectedStatus": 201,
          "expectedHeaders": {"content-type": "application/json"}
        }
      ]
    },
    "errorScenarios": {
      "description": "4xx and 5xx status codes, malformed requests",
      "scenarios": [
        {
          "name": "404 for invalid route",
          "method": "GET",
          "path": "/nonexistent",
          "expectedStatus": 404,
          "expectedError": "Not Found"
        },
        {
          "name": "400 for malformed JSON",
          "method": "POST", 
          "path": "/data",
          "body": "{invalid json}",
          "expectedStatus": 400,
          "expectedError": "Bad Request"
        },
        {
          "name": "405 for unsupported method",
          "method": "TRACE",
          "path": "/",
          "expectedStatus": 405,
          "expectedError": "Method Not Allowed"
        }
      ]
    },
    "boundaryConditions": {
      "description": "Large payloads, concurrent connections, timeout scenarios",
      "scenarios": [
        {
          "name": "Large payload handling",
          "method": "POST",
          "path": "/data",
          "bodySize": 2097152,
          "expectedStatus": 413,
          "expectedError": "Payload Too Large"
        },
        {
          "name": "Concurrent connections test",
          "method": "GET",
          "path": "/",
          "concurrentRequests": 100,
          "expectedSuccessRate": 0.95
        },
        {
          "name": "Request timeout handling",
          "method": "POST",
          "path": "/slow",
          "timeout": 1000,
          "expectedStatus": 408,
          "expectedError": "Request Timeout"
        }
      ]
    }
  },
